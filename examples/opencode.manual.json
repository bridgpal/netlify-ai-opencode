{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "netlify-anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "Netlify AI Gateway (Anthropic)",
      "options": {
        "baseURL": "https://YOUR-RELAY.netlify.app/anthropic/v1",
        "apiKey": "{env:NETLIFY_AI_RELAY_KEY}"
      },
      "models": {
        "claude-fable-5-1": { "name": "Claude Fable 5.1", "limit": { "context": 200000, "output": 64000 } },
        "claude-sonnet-5": { "name": "Claude Sonnet 5", "limit": { "context": 200000, "output": 64000 } },
        "claude-haiku-4-5": { "name": "Claude Haiku 4.5", "limit": { "context": 200000, "output": 64000 } }
      }
    },
    "netlify-openai": {
      "npm": "@ai-sdk/openai",
      "name": "Netlify AI Gateway (OpenAI)",
      "options": {
        "baseURL": "https://YOUR-RELAY.netlify.app/openai/v1",
        "apiKey": "{env:NETLIFY_AI_RELAY_KEY}"
      },
      "models": {
        "gpt-5": { "name": "GPT-5", "limit": { "context": 200000, "output": 32768 } },
        "gpt-5-mini": { "name": "GPT-5 mini", "limit": { "context": 200000, "output": 32768 } }
      }
    },
    "netlify-gemini": {
      "npm": "@ai-sdk/google",
      "name": "Netlify AI Gateway (Gemini)",
      "options": {
        "baseURL": "https://YOUR-RELAY.netlify.app/gemini/v1beta",
        "apiKey": "{env:NETLIFY_AI_RELAY_KEY}"
      },
      "models": {
        "gemini-2.5-pro": { "name": "Gemini 2.5 Pro", "limit": { "context": 200000, "output": 65536 } }
      }
    }
  }
}
